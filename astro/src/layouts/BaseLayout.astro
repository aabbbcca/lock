---
import "../styles/global.css";
import { brands, getElectronicBrandUrl } from "../lib/product-data.js";

const {
  title = "小李開鎖",
  description = "提供 24 小時開鎖、換鎖、電子鎖安裝等到府服務。",
  canonical = Astro.url.href
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_TW" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="shortcut icon" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-11203096643"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "AW-11203096643");

      function gtagSendEvent(url) {
        const callback = function () {
          if (typeof url === "string") {
            window.location = url;
          }
        };

        gtag("event", "ads_conversion___1", {
          event_callback: callback,
          event_timeout: 2000
        });

        return false;
      }

      window.gtagSendEvent = gtagSendEvent;
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">
        小李開鎖
        <span>全年 24 小時到府服務</span>
      </a>

      <nav class="nav-links">
        <a href="/">首頁</a>
        <div class="dropdown">
          <a class="dropbtn" href="/electronic-page/">
            電子鎖款式<i class="fas fa-caret-down"></i>
          </a>
          <div class="dropdown-content">
            {brands.map((brand) => (
              <a href={getElectronicBrandUrl(brand.id)}>{brand.title}</a>
            ))}
          </div>
        </div>
        <a href="/traditional-page/">傳統鎖款式</a>
        <a href="/unlock-page/">開鎖服務</a>
        <a href="/examples-page/">安裝案例</a>
        <a href="/#faq">常見問題</a>
      </nav>

      <div class="header-actions">
        <a href="https://line.me/ti/p/_w85tXo5KV" target="_blank" rel="noopener" class="cta-btn line-btn">
          <i class="fab fa-line"></i> LINE
        </a>
        <a href="tel:0903109970" class="cta-btn" onclick="return gtagSendEvent('tel:0903109970')">
          <i class="fas fa-phone-alt"></i> 立即來電
        </a>
        <button class="hamburger-icon" type="button" onclick="toggleMobileMenu()">
          <i class="fas fa-bars"></i>
          <span class="menu-text">選單</span>
        </button>
      </div>
    </header>

    <div id="mobile-menu" class="mobile-menu-container">
      <a class="mobile-menu-link" href="/">首頁</a>
      <button class="mobile-menu-link mobile-menu-button" type="button" onclick="toggleMobileSubmenu()">
        電子鎖款式<i class="fas fa-caret-down"></i>
      </button>
      <div id="mobile-submenu-list" class="mobile-submenu">
        {brands.map((brand) => (
          <a class="mobile-submenu-link" href={getElectronicBrandUrl(brand.id)}>{brand.title}</a>
        ))}
        <a class="mobile-submenu-link mobile-submenu-highlight" href="/electronic-page/">查看全部款式</a>
      </div>
      <a class="mobile-menu-link" href="/traditional-page/">傳統鎖款式</a>
      <a class="mobile-menu-link" href="/unlock-page/">開鎖服務</a>
      <a class="mobile-menu-link" href="/examples-page/">安裝案例</a>
      <a class="mobile-menu-link" href="/#faq">常見問題</a>
    </div>

    <slot />

    <footer class="site-footer">
      <p>&copy; 2026 小李開鎖. All rights reserved. | <a href="https://share.google/QnykUdfL2kR4e5KjI" target="_blank" rel="noopener">Google 商家資訊</a></p>
    </footer>

    <script is:inline>
      function toggleMobileMenu() {
        const menu = document.getElementById("mobile-menu");
        if (!menu) return;
        menu.classList.toggle("active");

        if (!menu.classList.contains("active")) {
          const submenu = document.getElementById("mobile-submenu-list");
          if (submenu) submenu.classList.remove("active");
        }
      }

      function toggleMobileSubmenu() {
        const submenu = document.getElementById("mobile-submenu-list");
        if (submenu) submenu.classList.toggle("active");
      }

      window.toggleMobileMenu = toggleMobileMenu;
      window.toggleMobileSubmenu = toggleMobileSubmenu;
    </script>
  </body>
</html>
