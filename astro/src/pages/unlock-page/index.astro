          midnight: { closed: 1000, broken: 2500, keyBroken: 1000 }
        }
      }
    };

    const state = {
      type: "",
      subtype: "",
      scooterService: "seat",
      steeringLocked: false,
      locked: false,
      segments: 1,
      lockStatus: "closed",
      displayPrice: "NT$ --",
      summary: ""
    };

    const stepEls = Array.from(document.querySelectorAll(".step-container"));
    const dynamicOptions = document.getElementById("dynamic-options");
    const nextToStep3Button = document.getElementById("to-step-3");
    const finalPriceDisplay = document.getElementById("final-price-display");
    const priceBreakdown = document.getElementById("price-breakdown");
    const resultPriceDisplay = document.getElementById("result-price-display");
    const resultSummary = document.getElementById("result-summary");
    const lineButton = document.getElementById("btn-wizard-line");
    const scooterOptionsContainer = document.getElementById("scooter-options-container");
    const scooterConditionOptions = document.getElementById("scooter-condition-options");
    const lockStatusToggle = document.getElementById("lock-status-toggle");
    const lockSegmentSelector = document.getElementById("lock-segment-selector");
    const lockStatusClosedButton = document.getElementById("lock-status-closed");
    const lockStatusLockedButton = document.getElementById("lock-status-locked");
