---
import BaseLayout from "../../layouts/BaseLayout.astro";

const unlockConfig = {
  step2: {
    electronic: [
      { id: "jiaan", label: "加安" },
      { id: "waferlock", label: "維夫拉克" },
      { id: "samsung", label: "三星" },
      { id: "yale", label: "耶魯" },
      { id: "other", label: "其他電子鎖" }
    ],
    traditional: [
      { id: "iron-3-4", label: "鐵門鎖（三段 / 四段）" },
      { id: "blade-5", label: "葉片五段鎖" },
      { id: "aux", label: "輔助鎖" },
      { id: "horizontal", label: "喇叭鎖 / 水平鎖" },
      { id: "integrated", label: "連體鎖" },
      { id: "gate-electric", label: "一樓公寓大門電鎖" }
    ],
    scooter: [
      { id: "yamaha", label: "山葉 YAMAHA" },
      { id: "sym", label: "三陽 SYM" },
      { id: "kymco", label: "光陽 KYMCO" },
      { id: "gogoro", label: "睿能 gogoro" }
    ],
    "access-control": [{ id: "access-control", label: "門禁系統" }],
    other: [
      { id: "car", label: "汽車開鎖" },
      { id: "safe", label: "保險箱" },
      { id: "mailbox", label: "信箱 / 抽屜" },
      { id: "other-question", label: "其他疑問" }
    ]
  }
};

const canonical = "https://xiao-li-locksmith.com/unlock-page/";
const pageTitle = "開鎖多少錢？24小時開鎖、夜間開鎖、半夜開鎖線上估價 | 小李開鎖";
const pageDescription =
  "想知道開鎖多少錢，或機車鑰匙不見怎麼辦？這頁整理雙北 24 小時開鎖、夜間開鎖、半夜開鎖與鎖匠到府服務的常見價格因素，包含傳統門鎖、電子鎖、機車開鎖，並提供線上估價。";
const faqItems = [
  {
    question: "開鎖多少錢？",
    answer:
      "一般住家或房門開鎖，常見會依鎖型、是否反鎖、服務時段、距離與樓層而不同。白天基本300元起，深夜及凌晨時段1000元起，特殊鎖、電子鎖或反鎖多段也會增加費用。"
  },
  {
    question: "為什麼同樣是開鎖，價格會不一樣？",
    answer:
      "影響價格的主因包括鎖的品牌與結構、是否故障、是否反鎖、到府距離、樓層條件，以及是否為夜間或凌晨服務。"
  },
  {
    question: "24小時開鎖、夜間開鎖、半夜開鎖有服務嗎？",
    answer:
      "有，雙北地區可提供 24 小時開鎖服務。"
  },
  {
    question: "需要找鎖匠時，先準備什麼能更快報價？",
    answer:
      "若能先提供門鎖照片、鎖的品牌型號、是否反鎖、現場地址與希望到場時段，鎖匠通常能更快判斷開鎖方式與大致費用。"
  },
  {
    question: "機車鑰匙不見怎麼辦？",
    answer:
      "小李師傅有現場無樣配鎖的服務。如果機車鑰匙不見，先確認是單純鎖在車廂，還是需要現場配新鑰匙。提供機車品牌、是否鎖龍頭、與所在位置，能更快評估機車開鎖或配鑰匙費用。一般機車開坐墊費用為500元，現場製作鑰匙含磁石為1200元。"
  },
  {
    question: "線上估價和現場報價會完全一樣嗎？",
    answer:
      "線上估價適合先抓預算，實際價格仍需以現場門型、鎖況與開鎖難度確認；若有門鎖照片，透過 LINE 傳給師傅，就能取得最終報價。"
  }
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "24小時開鎖與開鎖價格線上估價",
  serviceType: "24小時開鎖服務",
  url: canonical,
  areaServed: ["台北市", "新北市"],
  provider: {
    "@type": "LocalBusiness",
    name: "小李開鎖",
    telephone: "0903-109-970",
    url: "https://xiao-li-locksmith.com/"
  },
  description: pageDescription
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
>
  <main class="sub-page">
    <div class="page-header">
      <a class="back-btn" href="/">返回首頁</a>
      <h1>開鎖多少錢？24小時開鎖、夜間開鎖、半夜開鎖都可先試算</h1>
      <p>想找雙北鎖匠處理開鎖問題，或想知道機車鑰匙不見怎麼辦，可以先依鎖型、距離、時段與樓層試算，快速掌握白天、夜間與半夜開鎖的大致費用區間。</p>
    </div>

    <section class="section">
      <div class="section-inner">
        <h2 class="section-title">開鎖多少錢？24小時開鎖價格會受哪些因素影響？</h2>
        <div class="faq-list">
          <div class="faq-item">
            <div class="faq-q">1. 鎖的種類不同，價格就會不同</div>
            <div class="faq-a">傳統門鎖、電子鎖、機車開鎖、保險箱與門禁系統的處理方式都不同，所需工具與時間也不同，因此不同鎖匠案件價格自然不會一樣。</div>
          </div>
          <div class="faq-item">
            <div class="faq-q">2. 是否反鎖、故障或夜間開鎖</div>
            <div class="faq-a">只是關上門、反鎖多段、鎖體故障，施工難度差很多；夜間開鎖、半夜開鎖與凌晨到府通常也會比白天高。</div>
          </div>
          <div class="faq-item">
            <div class="faq-q">3. 距離與樓層也會影響到府費用</div>
            <div class="faq-a">若超過基本距離，或是高樓層且無電梯，通常會有額外加價，這也是為什麼同一種鎖每次由鎖匠到府處理時，報價可能不同。</div>
          </div>
        </div>
      </div>
    </section>

    <div class="wizard-container" id="unlock-wizard">
      <section class="step-container active" data-step="1">
        <div class="wizard-title">1. 先選擇需要處理的鎖型</div>
        <div class="option-grid">
          <button class="option-btn" type="button" data-type="electronic">電子鎖</button>
          <button class="option-btn" type="button" data-type="traditional">傳統鎖</button>
          <button class="option-btn" type="button" data-type="scooter">機車開鎖</button>
          <button class="option-btn" type="button" data-type="access-control">門禁系統</button>
          <button class="option-btn option-btn-full" type="button" data-type="other">其他項目</button>
        </div>
      </section>

      <section class="step-container" data-step="2">
        <div class="wizard-title">2. 補充鎖型與現場狀況</div>
        <div id="dynamic-options" class="option-grid"></div>

        <div id="scooter-options-container" class="inline-control-group hidden-block">
          <p class="helper-label">機車目前需要處理哪一項？</p>
          <div class="toggle-switch">
            <button id="btn-scooter-seat" class="toggle-btn active" type="button" data-scooter-service="seat">開車廂</button>
            <button id="btn-scooter-key" class="toggle-btn" type="button" data-scooter-service="key">配機車鑰匙</button>
          </div>
        </div>

        <div id="scooter-condition-options" class="inline-control-group hidden-block">
          <p class="helper-label">龍頭是否已鎖死？</p>
          <div class="toggle-switch">
            <button class="toggle-btn" type="button" data-steering-lock="true">有鎖龍頭 (+100)</button>
            <button class="toggle-btn active" type="button" data-steering-lock="false">沒有鎖龍頭</button>
          </div>
        </div>

        <div id="lock-status-toggle" class="inline-control-group hidden-block">
          <p class="helper-label">傳統鎖目前狀況</p>
          <div class="toggle-switch">
            <button class="toggle-btn active" type="button" data-lock-status="closed">只是關上</button>
            <button class="toggle-btn" type="button" data-lock-status="locked">反鎖卡住</button>
            <button class="toggle-btn" type="button" data-lock-status="broken">鎖體故障</button>
          </div>
        </div>

        <div id="lock-segment-selector" class="inline-control-group hidden-block">
          <p class="helper-label">若為反鎖，請選擇幾段上鎖</p>
          <div class="toggle-switch">
            <button class="toggle-btn active" type="button" data-segment="1">1 段</button>
            <button class="toggle-btn" type="button" data-segment="2">2 段</button>
            <button class="toggle-btn" type="button" data-segment="3">3 段</button>
            <button class="toggle-btn" type="button" data-segment="4">4 段</button>
          </div>
          <p class="helper-note">未確定時可先選 1 段估算。</p>
        </div>

        <div class="control-btns">
          <button id="back-to-step-1" class="btn-prev" type="button">上一步</button>
          <button id="to-step-3" class="btn-next" type="button" disabled>下一步</button>
        </div>
      </section>

      <section class="step-container" data-step="3">
        <div class="wizard-title">3. 填寫距離與時間</div>

        <div class="input-group">
          <label for="address-input">現場地址</label>
          <div class="address-row">
            <input id="address-input" type="text" placeholder="例如：新北市永和區..." />
            <button id="geo-btn" type="button" class="minor-action-btn">使用目前位置</button>
          </div>
        </div>

        <div class="input-group">
          <label for="distance-input">距離小李開鎖大約幾公里</label>
          <div class="address-row">
            <input id="distance-input" type="number" min="0" step="0.1" placeholder="例如：3.5" />
            <button id="maps-btn" type="button" class="minor-action-btn minor-action-btn-blue">開 Google 地圖</button>
          </div>
          <div class="helper-note">4 公里內為基本距離，超過後每多 1 公里加 NT$ 100。</div>
        </div>

        <div class="input-group">
          <label for="time-select">希望服務的時段</label>
          <select id="time-select">
            <option value="morning">08:00 - 09:00（早班）</option>
            <option value="day">09:00 - 21:00（日間）</option>
            <option value="evening">21:00 - 23:00（夜間）</option>
            <option value="late">23:00 - 00:00（深夜）</option>
            <option value="midnight">00:00 - 08:00（凌晨）</option>
          </select>
        </div>

        <div class="input-group">
          <label for="floor-select">樓層狀況</label>
          <select id="floor-select">
            <option value="0">1 樓 / 有電梯 / 4 樓以下</option>
            <option value="100">5 樓以上無電梯 (+100)</option>
          </select>
        </div>

        <div class="price-result">
          <div class="price-note">預估價格</div>
          <div class="final-price" id="final-price-display">NT$ --</div>
          <div class="price-note" id="price-breakdown">請先填入距離與時段</div>
        </div>

        <div class="control-btns">
          <button id="back-to-step-2" class="btn-prev" type="button">上一步</button>
          <button id="finish-estimate" class="btn-next" type="button">聯絡我</button>
        </div>
      </section>

      <section class="step-container" data-step="4">
        <div class="wizard-title wizard-title-success">估價完成</div>
        <div class="finish-summary">
          <p>以下是目前條件下的估價結果，實際價格仍以現場門型與鎖況為準。</p>
          <div class="final-price" id="result-price-display">NT$ --</div>
          <p id="result-summary" class="result-summary-text"></p>
        </div>
        <div class="cta-buttons cta-buttons-column">
          <a id="btn-wizard-line" class="btn-line">LINE 傳送估價內容</a>
          <a href="tel:0903109970" class="btn-phone">直接電話聯絡</a>
        </div>
        <div class="wizard-reset-actions">
          <button id="reset-wizard" class="btn-reset" type="button">重新估價</button>
          <a href="/">返回首頁</a>
        </div>
      </section>
    </div>

    <section class="section">
      <div class="section-inner unlock-tip-grid">
        <div class="unlock-tip-card">
          <h2>估價前可先準備</h2>
          <ul class="product-features">
            <li>門鎖照片或型號</li>
            <li>是否反鎖、卡住或沒電</li>
            <li>現場地址與方便的時間</li>
          </ul>
        </div>
        <div class="unlock-tip-card">
          <h2>什麼情況最適合先傳 LINE？</h2>
          <ul class="product-features">
            <li>不確定鎖型或品牌</li>
            <li>要更換鎖芯或整組門鎖</li>
            <li>現場還有特殊門型與配件</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section bg-light">
      <div class="section-inner">
        <h2 class="section-title">雙北鎖匠到府開鎖價格常見說明</h2>
        <div class="faq-list">
          <div class="faq-item">
            <div class="faq-q">傳統門鎖開鎖價格</div>
            <div class="faq-a">常見住家、房門、鐵門鎖會依是否反鎖、幾段鎖、是否故障來估價。若只是單純忘記帶鑰匙，通常會比鎖體損壞更單純。</div>
          </div>
          <div class="faq-item">
            <div class="faq-q">電子鎖開鎖價格</div>
            <div class="faq-a">電子鎖會受品牌與型號影響，例如不同品牌的結構與解鎖方式不同，價格通常比一般機械鎖更看品牌與現場狀況。</div>
          </div>
          <div class="faq-item">
            <div class="faq-q">機車開鎖價格</div>
            <div class="faq-a">機車開鎖常分為開車廂與配鑰匙兩種情況。若你正在搜尋機車鑰匙不見怎麼辦，通常要先判斷是鑰匙鎖在車廂、整把遺失，還是需要現場重配；是否鎖龍頭、是否有磁晶片、是否為深夜時段，都會讓價格不同。</div>
          </div>
          <div class="faq-item">
            <div class="faq-q">夜間開鎖與半夜開鎖價格</div>
            <div class="faq-a">晚上 9 點後、深夜 11 點後與凌晨時段，因為屬於夜間或半夜開鎖到府服務，通常會比日間開鎖價格更高，建議先用本頁估價再聯繫。</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <h2 class="section-title">24小時開鎖與鎖匠服務常見問題</h2>
        <div class="faq-list">
          {faqItems.map((item) => (
            <div class="faq-item">
              <div class="faq-q">{item.question}</div>
              <div class="faq-a">{item.answer}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script type="application/json" id="unlock-config" set:html={JSON.stringify(unlockConfig)}></script>
  <script is:inline>
    const configNode = document.getElementById("unlock-config");
    const config = configNode ? JSON.parse(configNode.textContent || "{}") : { step2: {} };
    const lineBaseUrl = "https://line.me/ti/p/_w85tXo5KV";

    const state = {
      type: "",
      subtype: "",
      scooterService: "seat",
      steeringLocked: false,
      locked: false,
      segments: 1,
      lockStatus: "closed",
      displayPrice: "NT$ --",
      summary: ""
    };

    const stepEls = Array.from(document.querySelectorAll(".step-container"));
    const dynamicOptions = document.getElementById("dynamic-options");
    const nextToStep3Button = document.getElementById("to-step-3");
    const finalPriceDisplay = document.getElementById("final-price-display");
    const priceBreakdown = document.getElementById("price-breakdown");
    const resultPriceDisplay = document.getElementById("result-price-display");
    const resultSummary = document.getElementById("result-summary");
    const lineButton = document.getElementById("btn-wizard-line");
    const scooterOptionsContainer = document.getElementById("scooter-options-container");
    const scooterConditionOptions = document.getElementById("scooter-condition-options");
    const lockStatusToggle = document.getElementById("lock-status-toggle");
    const lockSegmentSelector = document.getElementById("lock-segment-selector");
    const addressInput = document.getElementById("address-input");
    const distanceInput = document.getElementById("distance-input");
    const timeSelect = document.getElementById("time-select");
    const floorSelect = document.getElementById("floor-select");

    function showStep(step) {
      stepEls.forEach((el) => {
        el.classList.toggle("active", Number(el.dataset.step) === step);
      });
    }

    function resetConditionalBlocks() {
      scooterOptionsContainer.classList.add("hidden-block");
      scooterConditionOptions.classList.add("hidden-block");
      lockStatusToggle.classList.add("hidden-block");
      lockSegmentSelector.classList.add("hidden-block");
    }

    function selectType(type) {
      state.type = type;
      state.subtype = "";
      state.locked = false;
      state.lockStatus = "closed";
      state.segments = 1;

      document.querySelectorAll("[data-type]").forEach((button) => {
        button.classList.toggle("selected", button.dataset.type === type);
      });

      renderStep2Options();
      showStep(2);
    }

    function renderStep2Options() {
      resetConditionalBlocks();
      nextToStep3Button.disabled = true;
      dynamicOptions.innerHTML = "";

      const options = config.step2[state.type] || [];
      options.forEach((option) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "option-btn";
        button.dataset.subtype = option.id;
        button.textContent = option.label;
        button.addEventListener("click", () => selectSubtype(option.id));
        dynamicOptions.appendChild(button);
      });

      if (state.type === "scooter") {
        scooterOptionsContainer.classList.remove("hidden-block");
        scooterConditionOptions.classList.remove("hidden-block");
      }

      if (state.type === "traditional") {
        lockStatusToggle.classList.remove("hidden-block");
      }

      if (state.type === "access-control" && options[0]) {
        selectSubtype(options[0].id);
      }
    }

    function selectSubtype(subtype) {
      state.subtype = subtype;
      document.querySelectorAll("[data-subtype]").forEach((button) => {
        button.classList.toggle("selected", button.dataset.subtype === subtype);
      });
      nextToStep3Button.disabled = false;
      calculatePrice();
    }

    function setActiveByData(selector, key, value) {
      document.querySelectorAll(selector).forEach((button) => {
        button.classList.toggle("active", button.dataset[key] === String(value));
      });
    }

    function calculatePrice() {
      const timeVal = timeSelect.value;
      const floorCost = Number(floorSelect.value || 0);
      const dist = Number(distanceInput.value || 0);
      const isNight = timeVal === "evening" || timeVal === "late" || timeVal === "midnight";

      let basePrice = 300;
      if (timeVal === "morning") basePrice = 500;
      if (timeVal === "evening") basePrice = 500;
      if (timeVal === "late") basePrice = 700;
      if (timeVal === "midnight") basePrice = 1000;

      let typeCost = 0;
      let conditionCost = 0;
      let displayPrice = "";
      const details = [];

      if (state.type === "other") {
        if (state.subtype === "safe") basePrice = 800;
        else if (state.subtype === "car") basePrice = 1000;
        else basePrice = 300;
        details.push("其他專案另行評估");
      } else if (state.type === "access-control") {
        basePrice = isNight ? 1000 : 600;
        details.push("門禁系統到場評估");
      } else if (state.type === "scooter") {
        if (state.subtype === "gogoro") {
          basePrice = 600;
        } else if (state.scooterService === "seat") {
          if (timeVal === "late") basePrice = 600;
          else if (timeVal === "midnight") basePrice = 1000;
          else basePrice = 400;

          if (state.steeringLocked) {
            basePrice += 100;
            details.push("含龍頭鎖死");
          }
        } else if (state.scooterService === "key") {
          const isLateNight = timeVal === "late" || timeVal === "midnight";
          let noMagPrice = isLateNight ? 1400 : 1000;
          let magPrice = isLateNight ? 1600 : 1200;

          if (state.steeringLocked) {
            noMagPrice += 100;
            magPrice += 100;
            details.push("含龍頭鎖死");
          }

          const distCost = dist > 4 ? Math.ceil(dist - 4) * 100 : 0;
          if (floorCost > 0) details.push("樓層加價");
          if (distCost > 0) details.push("超過基本距離");

          displayPrice = `NT$ ${noMagPrice + floorCost + distCost}（無磁晶片） / NT$ ${magPrice + floorCost + distCost}（有磁晶片）`;
          finalPriceDisplay.textContent = displayPrice;
          priceBreakdown.textContent = details.length ? `說明：${details.join(" + ")}` : "依是否有磁晶片分為兩種估價";
          state.displayPrice = displayPrice;
          state.summary = buildSummary(displayPrice);
          return;
        }
      } else if (state.type === "electronic") {
        if (state.subtype === "waferlock") {
          basePrice = 0;
          typeCost = isNight ? 1500 : 1000;
        } else if (state.subtype === "samsung") {
          basePrice = 0;
          typeCost = isNight ? 6000 : 4000;
        } else if (state.subtype === "yale") {
          basePrice = 0;
          typeCost = 2500;
        } else if (state.subtype === "other") {
          basePrice = 600;
          if (timeVal === "morning" || timeVal === "evening") basePrice = 800;
          if (timeVal === "late") basePrice = 1000;
          if (timeVal === "midnight") basePrice = 1300;
        } else {
          typeCost = 300;
        }
        if (typeCost > 0) details.push("品牌 / 型號加價");
      } else if (state.type === "traditional") {
        if (state.subtype === "blade-5") typeCost = 200;
        if (state.locked) {
          const perSegmentCost = timeVal === "day" || timeVal === "morning" ? 200 : 300;
          conditionCost = perSegmentCost * state.segments;
          details.push(`反鎖 ${state.segments} 段`);
        }
      }

      const distCost = dist > 4 ? Math.ceil(dist - 4) * 100 : 0;
      if (floorCost > 0) details.push("樓層加價");
      if (distCost > 0) details.push("超過基本距離");

      const total = basePrice + typeCost + conditionCost + floorCost + distCost;
      displayPrice = `NT$ ${total.toLocaleString()}`;
      finalPriceDisplay.textContent = displayPrice;
      priceBreakdown.textContent = details.length ? `說明：${details.join(" + ")}` : "一般基本到場估價";
      state.displayPrice = displayPrice;
      state.summary = buildSummary(displayPrice);
    }

    function buildSummary(displayPrice) {
      const typeText = getLabelByValue("type", state.type);
      const subtypeText = getLabelByValue("subtype", state.subtype);
      const distanceText = distanceInput.value ? `${distanceInput.value} 公里` : "未填距離";
      const timeText = timeSelect.options[timeSelect.selectedIndex]?.text || "";
      return `${typeText} / ${subtypeText} / ${distanceText} / ${timeText} / 預估 ${displayPrice}`;
    }

    function getLabelByValue(kind, value) {
      if (kind === "type") {
        const mapping = {
          electronic: "電子鎖",
          traditional: "傳統鎖",
          scooter: "機車開鎖",
          "access-control": "門禁系統",
          other: "其他項目"
        };
        return mapping[value] || "未選擇";
      }

      const options = Object.values(config.step2).flat();
      return options.find((option) => option.id === value)?.label || "未選擇";
    }

    function fillStep4() {
      calculatePrice();
      resultPriceDisplay.textContent = state.displayPrice;
      resultSummary.textContent = state.summary;
      lineButton.href = `${lineBaseUrl}?text=${encodeURIComponent(`您好，我想詢問開鎖估價：${state.summary}`)}`;
      showStep(4);
    }

    document.querySelectorAll("[data-type]").forEach((button) => {
      button.addEventListener("click", () => selectType(button.dataset.type));
    });

    document.querySelectorAll("[data-scooter-service]").forEach((button) => {
      button.addEventListener("click", () => {
        state.scooterService = button.dataset.scooterService;
        setActiveByData("[data-scooter-service]", "scooterService", state.scooterService);
        calculatePrice();
      });
    });

    document.querySelectorAll("[data-steering-lock]").forEach((button) => {
      button.addEventListener("click", () => {
        state.steeringLocked = button.dataset.steeringLock === "true";
        setActiveByData("[data-steering-lock]", "steeringLock", state.steeringLocked);
        calculatePrice();
      });
    });

    document.querySelectorAll("[data-lock-status]").forEach((button) => {
      button.addEventListener("click", () => {
        state.lockStatus = button.dataset.lockStatus;
        state.locked = state.lockStatus === "locked";
        setActiveByData("[data-lock-status]", "lockStatus", state.lockStatus);
        lockSegmentSelector.classList.toggle("hidden-block", !state.locked);
        calculatePrice();
      });
    });

    document.querySelectorAll("[data-segment]").forEach((button) => {
      button.addEventListener("click", () => {
        state.segments = Number(button.dataset.segment || 1);
        setActiveByData("[data-segment]", "segment", state.segments);
        calculatePrice();
      });
    });

    [distanceInput, timeSelect, floorSelect].forEach((el) => {
      el.addEventListener("input", calculatePrice);
      el.addEventListener("change", calculatePrice);
    });

    document.getElementById("back-to-step-1")?.addEventListener("click", () => showStep(1));
    document.getElementById("back-to-step-2")?.addEventListener("click", () => showStep(2));
    nextToStep3Button?.addEventListener("click", () => {
      calculatePrice();
      showStep(3);
    });
    document.getElementById("finish-estimate")?.addEventListener("click", fillStep4);
    document.getElementById("reset-wizard")?.addEventListener("click", () => {
      state.type = "";
      state.subtype = "";
      state.scooterService = "seat";
      state.steeringLocked = false;
      state.locked = false;
      state.segments = 1;
      state.lockStatus = "closed";
      addressInput.value = "";
      distanceInput.value = "";
      floorSelect.value = "0";
      timeSelect.value = "day";
      finalPriceDisplay.textContent = "NT$ --";
      priceBreakdown.textContent = "請先填入距離與時段";
      document.querySelectorAll(".option-btn, .toggle-btn").forEach((button) => {
        button.classList.remove("selected", "active");
      });
      document.querySelector('[data-scooter-service="seat"]')?.classList.add("active");
      document.querySelector('[data-steering-lock="false"]')?.classList.add("active");
      document.querySelector('[data-lock-status="closed"]')?.classList.add("active");
      document.querySelector('[data-segment="1"]')?.classList.add("active");
      resetConditionalBlocks();
      dynamicOptions.innerHTML = "";
      nextToStep3Button.disabled = true;
      showStep(1);
    });

    document.getElementById("maps-btn")?.addEventListener("click", () => {
      const query = addressInput.value || "新北市永和區";
      window.open(`https://www.google.com/maps/search/${encodeURIComponent(query)}`, "_blank", "noopener");
    });

    document.getElementById("geo-btn")?.addEventListener("click", () => {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition((position) => {
        addressInput.value = `${position.coords.latitude.toFixed(6)}, ${position.coords.longitude.toFixed(6)}`;
      });
    });

    const currentHour = new Date().getHours();
    if (currentHour >= 8 && currentHour < 9) timeSelect.value = "morning";
    else if (currentHour >= 21 && currentHour < 23) timeSelect.value = "evening";
    else if (currentHour >= 23) timeSelect.value = "late";
    else if (currentHour < 8) timeSelect.value = "midnight";
    else timeSelect.value = "day";
  </script>
</BaseLayout>
